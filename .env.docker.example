# `make docker/run` 用の環境変数サンプル。`.env.docker` にコピーして使用する。
# Docker コンテナ内からホスト上の MySQL/Redis に接続する想定。

PORT=8080
LOG_LEVEL=info

# ホストの docker-compose で起動した MySQL/Redis を参照する場合。
# Linux ホストでは host.docker.internal が解決できないため `--add-host=host.docker.internal:host-gateway` を別途指定するか、コンテナを同一ネットワークに接続する。
MYSQL_DSN=game:game@tcp(host.docker.internal:3306)/game_db?parseTime=true&loc=Local
REDIS_ADDR=host.docker.internal:6379

# outbox-worker 用
OUTBOX_POLL_INTERVAL=10m
OUTBOX_BATCH_SIZE=100

# DB コネクションプール（未設定なら configs の既定値）。
# database/sql の既定は無制限 → 高負荷時に MySQL の max_connections(既定151)超過で
# "Too many connections" を誘発する。api/worker 合算で max_connections 未満に収めること。
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME=5m
DB_CONN_MAX_IDLE_TIME=5m
