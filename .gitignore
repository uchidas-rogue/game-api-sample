# ビルド成果物
/bin/

# ログファイル（logsフォルダ自体は.gitkeepで管理）
/logs/*
!/logs/.gitkeep

# 環境変数ファイル
.env
.env.*
!.env.example
!.env.docker.example

# カバレッジ出力（make test/race の生成物）
/coverage.out

# 負荷試験の計測出力（make load/watch の生成物。ルート直下に出力される）
/*.csv

# チャット中継（Cloudflare Workers）のローカル依存とローカル秘密情報。
# .dev.vars は API キーを含むので絶対にコミットしない（雛形の .dev.vars.example のみ管理）
/web/worker/node_modules/
/web/worker/.dev.vars
/web/worker/.wrangler/

# macOS
.DS_Store

# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
# .terraform.lock.hcl は コミット対象（プロバイダのバージョン固定）

.vscode
