# ビルド成果物
/bin/

# ログファイル（logsフォルダ自体は.gitkeepで管理）
/logs/*
!/logs/.gitkeep

# 環境変数ファイル
.env
.env.*
!.env.example
!.env.docker.example

# カバレッジ出力（make test/race の生成物）
/coverage.out

# macOS
.DS_Store

# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
# .terraform.lock.hcl は コミット対象（プロバイダのバージョン固定）

.vscode
