# ビルド成果物
/bin/

# ログファイル（logsフォルダ自体は.gitkeepで管理）
/logs/*
!/logs/.gitkeep

# 環境変数ファイル
.env
.env.*
!.env.example
!.env.docker.example

# カバレッジ出力（make test/race の生成物）
/coverage.out

# 負荷試験の計測出力（make load/watch の生成物。ルート直下に出力される）
/*.csv

# チャット中継（Cloudflare Workers）のローカル依存とローカル秘密情報。
# .dev.vars は API キーを含むので絶対にコミットしない（雛形の .dev.vars.example のみ管理）
/web/worker/node_modules/
/web/worker/.dev.vars
/web/worker/.wrangler/

# サイトのブラウザ側テスト（jsdom）のローカル依存。
# package-lock.json はバージョンを固定したいのでコミットする
/web/tests/node_modules/

# Unity クライアント（clients/unity/）。
# 生成済み C# と link.xml・サンプルはコミットするが、次は追跡しない:
#   - Unity プロジェクトのローカル生成物（Assets/ 配下へコピーして使う想定のため本来ここには出ないが、
#     試しに Unity プロジェクトを掘った場合に紛れ込む）
#   - NuGet / UPM で入れる DLL。ライセンス表記とサイズの管理コストに見合わないため、
#     README の手順で各自が導入する方針（clients/unity/README.md）
/clients/unity/**/Library/
/clients/unity/**/Temp/
/clients/unity/**/obj/
/clients/unity/**/Logs/
/clients/unity/**/*.csproj
/clients/unity/**/*.sln
/clients/unity/**/*.dll

# macOS
.DS_Store

# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
# .terraform.lock.hcl は コミット対象（プロバイダのバージョン固定）

.vscode
